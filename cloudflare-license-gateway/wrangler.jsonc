{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paldobog-nixware-license-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": { "enabled": true },
  "services": [
    {
      "binding": "PALDOBOG_PRIMARY",
      "service": "paldobog-license-api"
    }
  ]
}
